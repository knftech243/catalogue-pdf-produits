# Catalogue Express — variables d'environnement PUBLIQUES
#
# ⚠️ Toutes les variables préfixées par VITE_ sont intégrées dans le code envoyé au navigateur.
# N'y mettez JAMAIS de secret, token, mot de passe, clé API privée ou information bancaire.
# Copiez ce fichier en `.env.local` pour vos réglages locaux (ce fichier n'est pas versionné).

# URL publique du site, sans barre oblique finale (utilisée pour le sitemap, les URL canoniques
# et les balises Open Graph). À renseigner avant la mise en ligne.
VITE_SITE_URL=https://www.example.com

# Adresse e-mail de contact affichée sur la page Contact (laisser vide tant qu'elle n'existe pas).
VITE_CONTACT_EMAIL=

# Liens vers les comptes officiels (laisser vide tant qu'ils n'existent pas : rien ne s'affiche).
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_WHATSAPP=

# Future page de paiement externe (Gumroad, Payhip, Flutterwave…). Laisser vide en V1 :
# aucun paiement n'est actif. Voir docs/PAYMENT_INTEGRATION_GUIDE.md.
VITE_PREMIUM_CHECKOUT_URL=
